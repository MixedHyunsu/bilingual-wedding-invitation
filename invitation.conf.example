# 청첩장 한 건의 모든 정보를 담는 파일입니다.
# 이름, 예식 일시, 장소, 인사말, 사진, 계좌, RSVP 주소가 전부 여기 모입니다.
# src/ 의 HTML과 JS에는 실제 값이 없고 {{GROOM_NAME}} 같은 token만 있습니다.
# build.sh 가 이 파일을 읽어 token을 치환하고 dist/ 에 완성본을 만듭니다.
#
# 쓰는 방법
#   1) cp invitation.conf.example invitation.conf
#   2) 아래 값을 두 분의 정보로 바꿉니다.
#   3) ./build.sh   →   ./startup.sh   (http://localhost:8080)
#
#   invitation.conf 는 .gitignore 대상이라 commit되지 않습니다.
#
# 적는 규칙
#   - 값은 따옴표로 감쌉니다.            VENUE_NAME="별빛웨딩홀"
#   - \n 은 줄바꿈, \n\n 은 문단 나눔입니다. (인사말, 안내 문구)
#   - 목록은 콤마로 구분합니다.
#   - _KO 가 없는 값과 _KO 값은 한국어 page(main.html)에, _EN 값은 영어 page(en.html)에 나옵니다.
#   - # 으로 시작하는 줄은 주석입니다.
#
# 이 파일의 값은 전부 가상의 demo 데이터입니다. 그대로 build하면 demo 청첩장이 나옵니다.


# --- 배포 ---
# 공유 미리보기(og:image)는 절대 URL이어야 읽힙니다. 배포할 주소를 아직 모르면 비워 둡니다.
SITE_ORIGIN=""
# 처음 열었을 때(index.html) 보여줄 page입니다. main(한국어) 또는 en(영어).
DEFAULT_VERSION="main"


# --- 시간대 ---
# 날짜와 요일, 달력은 WEDDING_AT 에 적힌 현지 시각 그대로 계산됩니다.
# 하객의 기기 시간대가 예식장과 다르면(예: 해외 예식을 한국에서 열람) 그쪽 시각이 한 줄 더 나옵니다.
#   TIMEZONE  예식장의 IANA 시간대 이름     예: Asia/Seoul, Australia/Melbourne, America/New_York
#   TZ_LABEL  화면에 붙는 약어              예: KST, AEDT, EST
TIMEZONE="Asia/Seoul"
TZ_LABEL="KST"


# --- 신랑 ---
GROOM_NAME="김앙아"
GROOM_NAME_SHORT="앙아"
# 영어 이름은 '이름 성' 순서로 적습니다. 영어 page와 감사 인사 page에 쓰입니다.
GROOM_NAME_EN="Anga Kim"
# 한국어 page의 가족 소개 줄입니다. "김철수 · 이영희의 아들 앙아"
GROOM_PARENTS="김철수,이영희"
GROOM_RANK_KO="아들"

# --- 신부 ---
BRIDE_NAME="최엥에"
BRIDE_NAME_SHORT="엥에"
BRIDE_NAME_EN="Enge Choi"
BRIDE_PARENTS="최민수,박지영"
BRIDE_RANK_KO="딸"


# --- 예식 일시 ---
# offset을 포함한 ISO 8601로 적습니다. countdown, 달력, D-day, 감사 인사 page 공개 시각의 기준입니다.
WEDDING_AT="2027-05-15T12:00:00+09:00"
# 몇 분 전까지 도착해 달라고 안내할지 적습니다. 비우거나 0이면 안내 줄이 나오지 않습니다.
ARRIVE_BEFORE_MIN="30"


# --- 인사말 ---
# 제목, 본문, 맺음말(연한 글씨로 마지막에 붙음)입니다. 영어 본문을 비우면 제목만 나옵니다.
GREETING_TITLE_KO="소중한 분들을\n초대합니다"
GREETING_KO="서로 다른 길을 걸어온 두 사람이 만나\n이제 같은 곳을 바라보며\n인생이라는 긴 여정을\n함께 시작하려 합니다.\n\n기쁠 때나 슬플 때나\n서로의 가장 든든한 동반자가 되어\n믿음과 사랑으로 걸어가겠습니다."
GREETING_CLOSING_KO="저희의 새로운 시작을 알리는 자리에\n귀한 걸음 하시어 축복해 주시면\n더없는 기쁨으로 간직하겠습니다."
GREETING_TITLE_EN="Please join us in celebrating the wedding of"
GREETING_EN=""
GREETING_CLOSING_EN=""



# --- 폰트 ---
# src/js/fonts.js 의 FONT_PRESETS 에 있는 조합 id를 적습니다. 비우면 목록의 첫 조합입니다.
# 주소 뒤에 ?fonts=1 을 붙여 열면 화면 아래 선택 bar로 조합을 바꿔 가며 시험할 수 있습니다.
FONT_KO="gowun-batang"
FONT_EN="cormorant-jost"

# --- 예식장 ---
VENUE_NAME="별빛웨딩홀"
VENUE_HALL="그랜드홀"
# 영어 page에 나올 예식장 이름과 홀 이름입니다. 비우면 위 값을 그대로 씁니다.
VENUE_NAME_EN="Starlight Wedding Hall"
VENUE_HALL_EN="Grand Hall"
VENUE_ADDRESS="서울특별시 중구 세종대로 110"
VENUE_FLOOR="3층"
# 영어 page에 나올 주소입니다. 비우면 VENUE_ADDRESS 를 씁니다.
VENUE_ADDRESS_EN="110 Sejong-daero, Jung-gu, Seoul"
# '주소 복사' button이 clipboard에 넣는 문자열입니다.
VENUE_ADDRESS_COPY="서울특별시 중구 세종대로 110 별빛웨딩홀 3층"
# 영어 page의 Copy address button이 복사하는 문자열입니다. 비우면 위 값을 씁니다.
VENUE_ADDRESS_COPY_EN="Starlight Wedding Hall 3F, 110 Sejong-daero, Jung-gu, Seoul"
# 시간 안내("서울 현지 시간 기준 · 세레모니 시작")에 쓰는 도시 이름입니다. 비우면 도시 없이 나옵니다.
VENUE_CITY="서울"
VENUE_CITY_EN="Seoul"
# 장소 card 아래 한 줄 설명입니다.
VENUE_NEAR="시청역 인근"
VENUE_NEAR_EN="Near City Hall Station, Seoul"

# 지도 embed에 찍을 좌표와 확대 수준입니다. API key 없이 Google 지도로 그려집니다.
VENUE_LAT="37.5662952"
VENUE_LNG="126.9779451"
VENUE_MAP_ZOOM="16"
# 'Google 지도' button이 여는 link입니다. Google 지도에서 장소의 '공유' 주소를 붙여 넣으면 됩니다.
MAP_GOOGLE_URL="https://maps.google.com/?q=37.5662952,126.9779451"


# --- 오시는 길 / 안내 ---
INFO_TRANSIT="1호선 / 2호선 시청역 5번 출구에서 도보 3분\n버스는 시청역 또는 덕수궁 하차"
INFO_PARKING="건물 지하 주차장 이용\n무료주차 2시간"
INFO_MEAL="예식 30분 전부터 식사하실 수 있습니다."
INFO_TRANSIT_EN="3 minutes' walk from City Hall Station (Lines 1 and 2), exit 5."
INFO_PARKING_EN="Free parking for 2 hours in the basement car park."
INFO_MEAL_EN="Lunch is served from 30 minutes before the ceremony."


# --- 사진 ---
# src/photos/ 에 파일을 넣고 이름을 적습니다. 비우면 빈 자리로 나오고 화면은 깨지지 않습니다.
#   PHOTO_MAIN     표지의 아치 frame 사진
#   PHOTO_BLESS    하단 전체폭 사진 (비우면 자리째 빠집니다)
#   PHOTO_GALLERY  gallery. 3x3 pagination이라 9장이 한 page입니다.
#   PHOTO_OG_MAIN  공유 미리보기 사진. 비우면 PHOTO_MAIN 을 씁니다.
PHOTO_MAIN="demo-cover.jpg"
# 표지 사진 틀: photo(사진 비율 그대로) | arch(아치로 자름) | auto(가로면 photo, 세로면 arch)
PHOTO_MAIN_FRAME="auto"
PHOTO_BLESS="demo-bless.jpg"
PHOTO_GALLERY="demo-g01.jpg,demo-g02.jpg,demo-g03.jpg,demo-g04.jpg,demo-g05.jpg,demo-g06.jpg,demo-g07.jpg,demo-g08.jpg,demo-g09.jpg"
# gallery page 표시 순서(1부터 시작하는 page 번호). 비우면 적은 순서 그대로입니다.
GALLERY_ORDER_MAIN=""
PHOTO_OG_MAIN=""



# --- 드레스 코드 ---
# 제목(DRESS_CODE)을 비우면 section이 나오지 않습니다. NOTE 는 제목 아래 짧은 설명입니다(선택).
DRESS_CODE="Formal Attire"
DRESS_CODE_NOTE="밝은 색 옷도 환영합니다"
DRESS_CODE_EN="Formal Attire"
DRESS_CODE_NOTE_EN="Bright colours are welcome"

# --- RSVP ---
# 참석 응답을 받을 주소입니다(Google Form 등). 맨 아래 RSVP button이 이 주소를 엽니다.
# 비우면 RSVP section이 나오지 않습니다.
RSVP_URL="https://forms.gle/your-form-id"
# RSVP 안내문입니다. 마감일 등을 적습니다. \n 은 줄바꿈입니다. 비우면 기본 문구가 나옵니다.
RSVP_NOTE_KO="예식 준비를 위해 하객 명단을\n미리 확정하려 합니다.\n참석하시는 분은 4월 30일까지\n아래 버튼으로 알려주세요."
RSVP_NOTE_EN="To help us plan, please RSVP\nby 30 April using the button below."


# --- 마음 전하실 곳 (계좌) ---
# 한국어 page에만 나옵니다. 형식은 이름|은행|계좌번호, 사람은 콤마로 구분합니다.
# 한쪽을 비우면 그쪽 칸이, 둘 다 비우면 section 전체가 나오지 않습니다.
#
# 이 값은 난독화해서 넣으므로 결과물 어느 파일에도 평문 계좌번호가 남지 않습니다.
# 주의: 난독화는 암호화가 아닙니다. 목적은 검색 engine 노출과 자동수집 차단입니다.
GROOM_ACCOUNTS="김앙아|달빛은행|000-0000-0000,김철수|달빛은행|000-0000-0000"
BRIDE_ACCOUNTS="최엥에|달빛은행|000-0000-0000"


# --- 외부 서비스 (선택) ---
# 카카오톡 공유 key(Kakao Developers 앱의 JavaScript key). 있으면 공유창에 '카카오톡으로 공유하기'가 생깁니다.
# 도메인을 [플랫폼 키 > JavaScript SDK 도메인]과 [제품 링크 관리 > 웹 도메인] 두 곳에 등록해야 합니다.
KAKAO_JS_KEY=""
# Google Analytics 측정 ID(G- 로 시작). 비우면 script를 아예 불러오지 않습니다.
GA_MEASUREMENT_ID=""
